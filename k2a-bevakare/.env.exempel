# Kopiera till .env och fyll i. .env ska aldrig checkas in.
AVTAL_URL=https://minasidor.k2a.se/mypages/contract/DIN-AVTALSKOD
K2A_ANVANDARNAMN=
K2A_LOSENORD=
INTERVALL_SEK=300

# Sätt till 1 första gången: hittar knappen men klickar inte
TORRKORNING=1

# Push-notiser via ntfy. Egen server: http://<unraid-ip>:<port>/<ämne>
# eller publika: https://ntfy.sh/<svårgissat-ämne>
NTFY_URL=
# Bara om din ntfy-server kräver inloggning (åtkomsttoken som börjar på tk_)
NTFY_TOKEN=

# Valfritt: om knapparna eller inloggningsfälten inte hittas automatiskt
# AVBRYT_TEXT=avbryt\s+uppsägning
# BEKRAFTA_TEXT=^\s*(ja|bekräfta|ok)\s*$
# SEL_ANVANDARE=#username
# SEL_LOSENORD=#password
# SEL_SKICKA=button[type=submit]

# Webbgränssnitt (http://<server>:7373). Porten ändras i docker-compose.yml.
# Sätt ett lösenord om fler kan nå porten.
WEBB_LOSENORD=

# Om avtalslänken inte fungerar klickar bevakaren: Mina avtal -> AVTAL_NAMN
AVTAL_NAMN=Klaffgatan 2
# START_URL=https://minasidor.k2a.se/mypages

# Vid fel (t.ex. "Något gick fel" från K2A) börjar den om från avtalslistan
# FORSOK_VID_FEL=3
# PAUS_VID_FEL=10
# FEL_TEXT=något gick fel|ett fel uppstod|tekniskt fel
