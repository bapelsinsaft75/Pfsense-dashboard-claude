# ---- Nätverk (Unraid: befintligt macvlan-nätverk br0) ----
DOCKER_NETWORK=br0
CONTAINER_IP=192.168.2.50
# Adressen du surfar till. Används för Plex-inloggningen och delningslänkar.
PUBLIC_URL=http://192.168.2.50

# ---- TMDB (krävs) ----
# "API Read Access Token" från themoviedb.org -> Settings -> API (börjar med eyJ...)
TMDB_TOKEN=
# Antal filmer att importera första gången (20 000 tar ca 15 min, 49 000 ca 35 min)
MAX_MOVIES=20000
# Land för "Where to watch"
WATCH_REGION=SE

# ---- Plex (krävs för inloggning) ----
# Adress till din Plex-server från containern, t.ex. http://192.168.2.10:32400
PLEX_URL=
# Din Plex-token (se README)
PLEX_TOKEN=
# Hur ofta Plex-biblioteken synkas (timmar)
PLEX_LIBRARY_SYNC_HOURS=12
# Hur ofta sett-historik och Seerr-status synkas (minuter)
PLEX_SYNC_MINUTES=30

# ---- IMDb-betyg (valfritt) ----
# Tas i första hand från Plex. Gratis nyckel från omdbapi.com används när Plex saknar betyget.
OMDB_API_KEY=

# ---- Önskningar ----
# watchlist (standard): "Request" lägger titeln på användarens egen Plex-watchlist.
#   Seerr:s "Plex Watchlist Sync" önskar den sedan i användarens namn (kräver Auto-Request-behörighet i Seerr).
# seerr: skicka önskan direkt till Seerr via API.
REQUEST_MODE=watchlist

# Seerr (seerr.dev) – fungerar även med Overseerr/Jellyseerr. Adress sedd från containern, t.ex. http://192.168.2.20:5055
# API-nyckeln finns i Seerr under Settings -> General -> API Key
SEERR_URL=
SEERR_API_KEY=
# ... eller Radarr direkt
RADARR_URL=
RADARR_API_KEY=
RADARR_ROOT_FOLDER=
RADARR_QUALITY_PROFILE=
